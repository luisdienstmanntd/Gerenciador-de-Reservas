{
  "hosting": {
    "site": "osteriadilucca",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "**/*.test.js",
      "**/*.md",
      "**/*.sql",
      "scripts/**",
      "supabase/**",
      "outputs/**",
      "work/**",
      "firebase-debug.log",
      "package.json",
      "package-lock.json",
      "prompt.md",
      "TESTES.md",
      "README.md",
      "firestore.rules"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}

